{
  "name": "dsh-files-lite",
  "version": "0.1.0",
  "description": "接管官方右侧栏文件树(kind 'files'): 逐级懒加载 + 「显示隐藏文件」眼睛开关, 纯客户端插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./zones": {
      "default": "./lib/zones.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
