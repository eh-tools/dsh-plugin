{
  "name": "dsh-db-console",
  "version": "0.2.0",
  "description": "数据库控制台: 会话头部新增「数据库」页签, 每项目一条 PostgreSQL 连接(完整链接串登录, 明文存 Host 侧), schema 树 + SQL 编辑器(三级补全+高亮) + 结果网格。静态双半插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
