{
  "name": "dsh-file-git-explorer",
  "version": "0.7.0",
  "description": "官方右侧栏「git 页签」(变更列表 + 提交历史) + 详情悬浮面板(官方正文与 diff 都由官方 float 承载) + 终端抽屉(真 PTY: node-pty ↔ WebSocket ↔ xterm.js), 静态双半插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
